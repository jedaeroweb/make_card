<div class="card mb-3 shadow-sm" data-controller="collapse-icon">
  <div
    class="card-header d-flex justify-content-between align-items-center"
    role="button"
    style="cursor: pointer;"
    data-action="click->collapse-icon#toggle"
  >
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" checked>
      <label class="form-check-label" for="switchCheckChecked"><%=t(:use) %></label>
    </div>
    <span class="fw-bold">오시는길</span>

    <span>
      <i class="bi bi-eye-fill d-none" data-collapse-icon-target="openIcon"></i>
      <i class="bi bi-eye-slash-fill" data-collapse-icon-target="closeIcon"></i>
    </span>
  </div>

  <div class="card-body d-none" data-collapse-icon-target="body">
    <%= form_with model: map do |f| %>
      <% if map.errors.any? %>
        <div style="color:red; margin-bottom:16px;">
          <h3><%= pluralize(map.errors.count, "error") %> 발생</h3>
          <ul>
            <% map.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>
      <%= f.submit t(:apply), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>