<%= form_with model: card, data: { turbo_frame: "_top" } do |f| %>

      <div class="mb-3">
        <%= f.label :title, "제목", class: "form-label" %>
        <%= f.text_field :title,
                         class: "form-control form-control-lg #{'is-invalid' if card.errors[:title].any?}",
                         maxlength: 60,
                         placeholder: "제목을 입력해주세요" %>

        <% if card.errors[:title].any? %>
          <div class="invalid-feedback d-block">
            <%= card.errors[:title].first %>
          </div>
        <% end %>
      </div>

      <div class="mb-3">
        <%= f.label :event_time, "시간", class: "form-label" %>
        <%= f.datetime_field :event_time,
                             class: "form-control form-control-lg #{'is-invalid' if card.errors[:event_time].any?}",
                             min: Time.zone.tomorrow.beginning_of_day.strftime("%Y-%m-%dT%H:%M") %>

        <% if card.errors[:event_time].any? %>
          <div class="invalid-feedback d-block">
            <%= card.errors[:event_time].first %>
          </div>
        <% end %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "저장", class: "btn btn-primary" %>
      </div>
<% end %>