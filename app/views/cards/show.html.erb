<%
  unless (params[:no_nav])
    content_menu_class = 'nav-link'
    picture_menu_class = 'nav-link'
    gallery_menu_class = 'nav-link'

    case params[:tab]
    when 'content'
      content_menu_class += ' active'
    when 'picture'
      picture_menu_class += ' active'
    when 'gallery'
      gallery_menu_class += ' active'
    else
      default_menu_class += ' active'
    end
%>
<section>



  <article>
    <h3><%=@card.title %></h3>
  </article>


  <% end %>
  <div class="row">
    <nav class="col-12">
      <ul class="nav nav-tabs">
        <li class="nav-item"><%= link_to('내용', { :tab => 'content' }, :class => content_menu_class) %></li>
        <li class="nav-item"><%= link_to('이미지', {  :tab => 'picture' }, :class => picture_menu_class) %></li>
        <li class="nav-item"><%= link_to('갤러리', { :tab => 'gallery' }, :class => gallery_menu_class) %></li>
      </ul>
    </nav>
  </div>
  <% if @card.card_contents_count.zero? %>
  <article>
  </article>
  <% else %>
    <article>
    </article>
  <% end %>
  <%= link_to t(:new_card_content),  new_card_content_path(card: @card), class: "btn btn-lg" %>




  <% if @card.card_pictures_count.zero? %>
  <% else %>
    <article>

    </article>
  <% end %>
  <%= link_to t(:card_picture),  new_card_content_path(card: @card), class: "btn btn-lg" %>


  <% if @card.galleries_count.zero? %>
  <% else %>
  <article>


  </article>
  <% end %>
  <%= link_to t(:new_gallery), new_gallery_path(card: @card), class: "btn btn-lg" %>

</section>