<style>
    .gallery-section {
        padding: 20px 0;
    }

    .gallery-section ul {
        list-style: none;
        margin: 0;
        padding: 0;

        display: flex;
        flex-wrap: wrap;
    }

    .gallery-section li {
        width: 33.3333%;
        padding: 10px;
        box-sizing: border-box;
    }

    .gallery-section li a {
        display: block;
        width: 100%;
    }

    .gallery-section li img {
        display: block;
        margin: 0 auto;
        height: auto;
        border-radius: 8px; /* rounded 대체 가능, 있으면 생략 가능 */
    }
</style>
<section  id="<%= dom_id(gallery) %>" class="gallery-section" data-aos="fade-up" data-aos-duration="1000" data-aos-offset="150">
  <h2 id="<%= dom_id(gallery, :title) %>" style="
  <%= "color: #{gallery.title_color};" if gallery.title_color.present? %>
    <%= "font-size: #{gallery.title_size}px;" if gallery.title_size.present? %>
    <%= "text-align: #{gallery.title_align};" if gallery.title_align.present? %>
  "><%= gallery.title %></h2>
  <div id="<%= dom_id(gallery, :display_list) %>" style="margin: 0 auto">
    <%= render "gallery_pictures/display_list", gallery: gallery %>
  </div>
</section>