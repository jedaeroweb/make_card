<div id="<%= dom_id(gallery_picture) %>" class="col-6 col-md-4 col-lg-3 mb-3">
  <div class="card h-100 shadow-sm">
    <% if gallery_picture.picture.present? && gallery_picture.picture.url.present? %>
      <%= image_tag gallery_picture.picture.url,
                    class: "card-img-top img-fluid d-block w-100",
                    style: "height: 180px; object-fit: cover; background: #f8f9fa;" %>
    <% else %>
      <div class="d-flex align-items-center justify-content-center bg-light text-muted"
           style="height: 180px;">
        이미지 없음
      </div>
    <% end %>

    <div class="card-body p-2">
      <div style="font-size: 11px; color: #666; word-break: break-all;">
        <%= gallery_picture.picture.url %>
      </div>

      <div class="d-grid mt-2">
        <%= button_to "삭제",
                      gallery_gallery_pictures_path(gallery_picture),
                      method: :delete,
                      form: { data: { turbo_confirm: "이 이미지를 삭제할까요?" } },
                      class: "btn btn-sm btn-outline-danger" %>
      </div>
    </div>
  </div>
</div>