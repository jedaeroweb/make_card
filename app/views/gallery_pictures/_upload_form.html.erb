<% input_id = "#{dom_id(gallery)}_pictures_input" %>

<div class="mb-3">
  <%= label_tag input_id, "이미지 업로드", class: "form-label" %>

  <%= file_field_tag "gallery_pictures[]",
                     id: input_id,
                     multiple: true,
                     accept: "image/*",
                     class: "form-control",
                     data: {
                       action: "change->gallery-upload#submit",
                       gallery_upload_target: "input"
                     } %>

  <div class="form-text">여러 장 선택 가능</div>
</div>