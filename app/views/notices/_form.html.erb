<div class="card mb-3 shadow-sm" data-controller="collapse-icon">
  <div
    class="card-header d-flex justify-content-between align-items-center"
    role="button"
    style="cursor: pointer;"
    data-action="click->collapse-icon#toggle"
  >
    <span class="fw-bold">제목과 내용</span>

    <span>
      <i class="bi bi-eye-fill" data-collapse-icon-target="openIcon"></i>
      <i class="bi bi-eye-slash-fill d-none" data-collapse-icon-target="closeIcon"></i>
    </span>
  </div>

  <div class="card-body" data-collapse-icon-target="body">
    <%= form_with model: notice, local: false do |f| %>
      <% if notice.errors.any? %>
        <div class="alert alert-danger mb-3">
          <h6 class="fw-bold mb-2"><%= pluralize(notice.errors.count, "error") %> 발생</h6>
          <ul class="mb-0 ps-3">
            <% notice.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- 제목 -->
      <div class="mb-3">
        <%= f.label :title, class: "form-label fw-semibold mb-2" %>
        <%= f.text_field :title,
                         class: "form-control",
                         placeholder: "제목을 입력해주세요" %>
      </div>

      <%= render "notices/title_option", f:f %>

      <!-- 내용 -->
      <div class="mb-3" data-controller="trix-no-upload">
        <%= f.label :content, class: "form-label fw-semibold mb-2" %>
        <%= f.rich_text_area :content %>
      </div>

      <!-- 내용 스타일 토글 -->
      <div class="mb-4" data-controller="option-toggle">
        <button
          class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill"
          type="button"
          data-action="click->option-toggle#toggle"
        >
          <i class="bi bi-brush"></i>
          <span>내용 스타일</span>
          <i class="bi bi-chevron-down transition-icon" data-option-toggle-target="icon"></i>
        </button>

        <div class="d-none mt-3" data-option-toggle-target="panel">
          <div class="p-3 bg-light rounded border">
            <div class="row g-2 align-items-end">
              <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">크기</label>
                <div class="input-group">
                  <%= f.number_field :content_size,
                                     class: "form-control",
                                     min: 8,
                                     max: 120,
                                     placeholder: "16" %>
                  <span class="input-group-text">px</span>
                </div>
              </div>

              <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">색상</label>
                <%= f.color_field :content_color,
                                  class: "form-control form-control-color w-100",
                                  title: "내용 색상" %>
              </div>

              <div class="col-6 col-md-3">
                <%= f.label :content_align, "정렬", class: "form-label small text-muted mb-1" %>
                <%= f.select :content_align,
                             [["왼쪽", "left"], ["가운데", "center"], ["오른쪽", "right"]],
                             { selected: f.object.content_align.presence || "left" },
                             class: "form-select" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%= f.submit t(:apply), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>