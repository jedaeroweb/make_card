<div id="<%= dom_id(notice) %>" class="card mb-3 shadow-sm" data-controller="collapse-icon">
  <div
    class="card-header d-flex justify-content-between align-items-center"
    role="button"
    style="cursor: pointer;"
    data-action="click->collapse-icon#toggle"
  >
    <span class="fw-bold"><%= notice.title.presence || "제목 없음" %></span>

    <span>
      <i class="bi bi-eye-fill" data-collapse-icon-target="openIcon"></i>
      <i class="bi bi-eye-slash-fill d-none" data-collapse-icon-target="closeIcon"></i>
    </span>
  </div>

  <div class="card-body" data-collapse-icon-target="body">
    <%= render "form", notice: notice %>

    <hr>

    <%= button_to "삭제",
                  notice_path(notice),
                  method: :delete,
                  class: "btn btn-outline-danger btn-sm",
                  form: { data: { turbo_confirm: "삭제할까요?" } } %>
  </div>
</div>