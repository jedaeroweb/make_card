<div id="<%= dom_id(card_picture, :form_wrapper) %>">
  <%= form_with model: [card, card_picture], multipart: true, html: { class: "mt-3" } do |f| %>
    <% if card_picture.errors.any? %>
      <div class="alert alert-danger mb-3">
        <h6 class="fw-bold mb-2"><%= pluralize(card_picture.errors.count, "error") %> 발생</h6>
        <ul class="mb-0 ps-3">
          <% card_picture.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :alt, class: "form-label fw-semibold mb-2" %>
      <%= f.text_field :alt,
                       class: "form-control",
                       placeholder: "제목을 입력해주세요" %>
    </div>

    <div class="mt-3">
      <%= render "card_pictures/preview", card: card, card_picture: card_picture %>
    </div>

    <div class="mb-3">
      <label class="form-label">이미지 업로드</label>

      <%= f.file_field :picture,
                       accept: "image/*",
                       class: "form-control" %>
    </div>

    <%= f.submit t(:apply), class: "btn btn-primary" %>
  <% end %>
</div>